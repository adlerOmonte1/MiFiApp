# Copia este archivo como .env y completa los valores reales.
# .env.local está en .gitignore — nunca commitear secretos.
#
# ⚠️ IMPORTANTE: en Expo, TODA variable con prefijo EXPO_PUBLIC_ se inyecta
# EN TEXTO PLANO en el bundle compilado. Cualquiera que descargue el .apk /
# .ipa puede leerla. Acá van SOLO valores públicos (URLs de la API).
#
# Los secretos del backend (JWT_SECRET, ENCRYPTION_KEY, credenciales de
# Google) NO van nunca en este repo: viven en MiFiBackend/.env y el cliente
# jamás los ve. El client_id de OAuth de Google sí es público por diseño;
# el client_secret NO, y el flujo de expo-auth-session usa PKCE justamente
# para no necesitarlo en el cliente.

# URL base de la API. Debe incluir /api, igual que los servers del
# openapi.yaml del backend.
#
# - Emulador Android: 10.0.2.2 es el alias del localhost de la máquina
#   anfitriona. "localhost" apuntaría al propio emulador y falla.
# - Dispositivo físico con Expo Go: usá la IP LAN de tu máquina
#   (ej. http://192.168.1.40:3000/api).
# - Simulador iOS y web: localhost funciona tal cual.
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Client ID de OAuth de Google para el login con Gmail (RF-23 a RF-25).
# Es público por diseño. El secret queda solo en el backend.
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
